{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "scripts/hooks/block-pbxproj.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "scripts/hooks/swift-post-edit.sh", "timeout": 90, "statusMessage": "Formatting and linting Swift…" } ] }
    ]
  }
}
